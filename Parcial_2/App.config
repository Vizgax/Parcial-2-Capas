<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <connectionStrings>
        <!--
          Conexión ESPECÍFICA de la aplicación (privilegios mínimos):
          el login "almacen_app" solo puede EJECUTAR los procedimientos almacenados de AlmacenDB.
          Cambie "Data Source" según su instancia de SQL Server:
              .\SQLEXPRESS            -> SQL Server Express (instancia con nombre)
              localhost  ó  .          -> instancia predeterminada (MSSQLSERVER)
              (localdb)\MSSQLLocalDB   -> LocalDB (requiere crear el login allí)
          Si cambia la contraseña en el script SQL, cámbiela también aquí.
        -->
        <add name="AlmacenDB"
             connectionString="Data Source=MSI\SQLEXPRESS;Initial Catalog=AlmacenDB;User ID=almacen_app;Password=Alm@cen_App#2026;TrustServerCertificate=True;Connect Timeout=10"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
